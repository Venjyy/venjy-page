      "css": ".ds-campo{display:grid;gap:6px;font-family:'PixelCraft',ui-monospace,monospace;color:#e6e6e6;font-size:18px}.ds-campo input{font:inherit;padding:10px 12px;color:#fff;background:#000;border:3px solid #a0a0a0;border-radius:0;caret-color:#ffff55}.ds-campo input:focus{outline:none;border-color:#fff}"
