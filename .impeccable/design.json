  "components": [
    {
      "name": "Botón de Minecraft",
      "kind": "button",
      "refersTo": "boton",
      "description": "Botón gris biselado del juego; hover azul con texto amarillo.",
      "html": "<button class=\"ds-boton\">Descargar CV</button>",
      "css": ".ds-boton{font-family:'PixelCraft',ui-monospace,monospace;font-size:17px;display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:6px 22px 9px;color:#fff;text-shadow:.1em .1em 0 #3f3f3f;background:#6f6f6f;border:3px solid #000;border-radius:0;box-shadow:inset 3px 3px 0 #a9a9a9,inset -3px -5px 0 #3e3e3e;cursor:pointer;transition:background-color 80ms linear}.ds-boton:hover{background:#4f5590;box-shadow:inset 3px 3px 0 #8f95cf,inset -3px -5px 0 #333865;color:#ffff55}.ds-boton:focus-visible{outline:3px solid #ffff55;outline-offset:3px}.ds-boton:active{transform:translateY(2px);box-shadow:inset 3px 3px 0 #3e3e3e,inset -3px -3px 0 #a9a9a9}"
    },
    {
      "name": "Botón verde",
      "kind": "button",
      "refersTo": "boton-verde",
      "description": "Acción principal dentro de un tooltip.",
      "html": "<button class=\"ds-boton-verde\">Ver en línea</button>",
      "css": ".ds-boton-verde{font-family:'PixelCraft',ui-monospace,monospace;font-size:17px;min-height:46px;padding:6px 22px 9px;color:#fff;text-shadow:.1em .1em 0 #3f3f3f;background:#2f7420;border:3px solid #000;border-radius:0;box-shadow:inset 3px 3px 0 #6cc349,inset -3px -5px 0 #24561a;cursor:pointer}.ds-boton-verde:hover{background:#357a22;box-shadow:inset 3px 3px 0 #86d965,inset -3px -5px 0 #2b6a1f}.ds-boton-verde:focus-visible{outline:3px solid #ffff55;outline-offset:3px}"
    },
    {
      "name": "Ficha de inventario",
      "kind": "button",
      "refersTo": "ficha",
      "description": "Ranura hundida con ícono pixelado y texto; acciones de la portada.",
      "html": "<a class=\"ds-ficha\" href=\"#\"><svg width=\"34\" height=\"34\" viewBox=\"0 0 8 8\" shape-rendering=\"crispEdges\"><rect x=\"1\" y=\"2\" width=\"6\" height=\"5\" fill=\"#a86c2a\"/><rect x=\"1\" y=\"2\" width=\"6\" height=\"1\" fill=\"#7c4b1b\"/><rect x=\"3\" y=\"4\" width=\"2\" height=\"1\" fill=\"#d6d6d6\"/></svg><span>Currículum</span></a>",
      "css": ".ds-ficha{font-family:'PixelCraft',ui-monospace,monospace;display:inline-flex;align-items:center;gap:10px;min-height:52px;padding:6px 16px 6px 8px;color:#fff;text-decoration:none;background:#8b8b8b;border:3px solid;border-color:#373737 #fff #fff #373737;outline:3px solid #000;text-shadow:.1em .1em 0 #3f3f3f;font-size:18px}.ds-ficha:hover{background:#a8a8a8;color:#ffff55}.ds-ficha:focus-visible{outline:3px solid #ffff55;outline-offset:3px}"
    },
    {
      "name": "Tooltip de ítem",
      "kind": "card",
      "refersTo": "tooltip",
      "description": "Contenedor de lectura de experiencia y proyectos.",
      "html": "<div class=\"ds-tooltip\"><h3 class=\"ds-tt-titulo\">Cofundador y desarrollador</h3><p class=\"ds-tt-gris\">2026 – presente</p><p class=\"ds-tt-desc\">Aplicación web en producción para confeccionar actas desde el celular.</p><p class=\"ds-tt-enc\">Next.js, TypeScript, Prisma</p></div>",
      "css": ".ds-tooltip{position:relative;padding:24px 28px 26px;background:rgb(16 0 16 / .95);border:3px solid #100010;font-family:'PixelCraft',ui-monospace,monospace;font-size:18px;line-height:1.55;color:#fff}.ds-tooltip::before{content:'';position:absolute;inset:0;border:3px solid;border-color:#5a1fd1 #2b0a6b #2b0a6b #5a1fd1;pointer-events:none}.ds-tt-titulo{margin:0;font-weight:normal;font-size:1.6rem;line-height:1.2;color:#ffaa00;text-shadow:.1em .1em 0 rgb(0 0 0 / .7)}.ds-tt-gris{margin:0;color:#aaa;font-size:16px}.ds-tt-desc{margin:14px 0 0;color:#e6e6e6}.ds-tt-enc{margin:16px 0 0;color:#8b8bff;font-size:16px}"
    },
    {
      "name": "Marco de ítem",
      "kind": "card",
      "refersTo": "marco",
      "description": "Marco de roble biselado para imágenes y video.",
      "html": "<figure class=\"ds-marco\"><div class=\"ds-marco-img\"></div></figure>",
      "css": ".ds-marco{margin:0;width:220px;background:#2b1c0e;border:9px solid;border-color:#b8945f #6e5431 #6e5431 #b8945f;outline:3px solid #2b1c0e}.ds-marco-img{aspect-ratio:4/3;background:repeating-linear-gradient(90deg,#7fb238 0 16px,#5d8a26 16px 32px)}.ds-marco:hover{border-color:#d2ad72 #8a6a3d #8a6a3d #d2ad72}"
    },
    {
      "name": "Logro",
      "kind": "custom",
      "refersTo": "logro",
      "description": "Toast de logro; también la lista de logros de Sobre mí.",
      "html": "<div class=\"ds-logro\"><span class=\"ds-logro-icono\"></span><span class=\"ds-logro-titulo\">Logro desbloqueado</span><span class=\"ds-logro-texto\">App en producción</span></div>",
      "css": ".ds-logro{display:grid;grid-template-columns:48px 1fr;column-gap:14px;align-items:center;width:360px;padding:12px 18px 13px 12px;background:#212121;border:3px solid #000;box-shadow:inset 0 0 0 3px #555;font-family:'PixelCraft',ui-monospace,monospace;font-size:16px}.ds-logro-icono{grid-row:1/3;width:40px;height:40px;margin-left:4px;background:#17dd62;box-shadow:inset -4px -4px 0 #0c8b3a}.ds-logro-titulo{color:#ffff55;line-height:1.3}.ds-logro-texto{color:#fff;line-height:1.4}"
    },
    {
      "name": "Campo de chat",
      "kind": "input",
      "refersTo": "campo",
