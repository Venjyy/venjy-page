      "css": ".ds-barra{display:inline-flex;padding:3px;background:rgb(28 28 28 / .82);border:3px solid #000;font-family:'PixelCraft',ui-monospace,monospace;}.ds-ranura{position:relative;display:grid;place-items:end;width:50px;height:50px;padding:0 3px;box-sizing:border-box;color:#fff;font-size:13px;text-decoration:none;text-shadow:.1em .1em 0 #3f3f3f;background:rgb(139 139 139 / .25);border:3px solid;border-color:#2b2b2b #6f6f6f #6f6f6f #2b2b2b}.ds-ranura:hover{background:rgb(255 255 255 / .18)}.ds-ranura:focus-visible{outline:3px solid #ffff55;outline-offset:3px}.ds-activa::after{content:'';position:absolute;inset:-7px;border:4px solid #e8e8e8;outline:2px solid #000;box-shadow:inset 0 0 0 2px #000}.ds-es{place-items:center;font-size:17px;color:#ffff55}"
