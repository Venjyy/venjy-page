{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salonas.schema.json",
  "title": "Salonas: La Gira (mundo/datos/salonas.json)",
  "description": "Ajustes del juego y reglas de partitura; las claves ausentes usan los valores del código. Textos editables en español e inglés.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "$ref": "comun.schema.json#/$defs/version" },
    "nota": { "$ref": "comun.schema.json#/$defs/nota" },
    "juego": { "$ref": "#/$defs/ajustes" },
    "reglas": { "$ref": "#/$defs/ajustes" },
    "textos": { "$ref": "#/$defs/textos" },
    "ajustes": { "$ref": "#/$defs/ajustesMano" }
  },
  "required": ["version", "juego", "reglas", "textos"],
  "additionalProperties": false,
  "$defs": {
    "ajustesMano": {
      "description": "Ajustes a mano de la partitura (pestaña Ritmo): canción → dificultad → «compás:paso» → carril (0 a 3) o null para quitar la nota. Nunca cambian cuándo suena una nota.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]+:[0-9]+$" },
          "additionalProperties": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 }
        }
      }
    },
    "ajustes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/valor" } },
    "valor": {
      "anyOf": [
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/valor" } },
        { "type": "array", "items": { "$ref": "#/$defs/valor" } },
        { "type": ["string", "number", "boolean"] }
      ]
    },
    "textos": { "type": "object", "additionalProperties": { "$ref": "#/$defs/textoOGrupo" } },
    "textoOGrupo": {
      "oneOf": [
        { "$ref": "comun.schema.json#/$defs/texto" },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/textoOGrupo" } }
      ]
    }
  }
}
